+const mul2 = (a0: bigint, a1: bigint, b0: bigint, b1: bigint): [bigint, bigint] => {
+  const v0 = mod(a0 * b0); const v1 = mod(a1 * b1);
+  return [mod(v0 - v1), mod(mod((a0 + a1) * (b0 + b1)) - mod(v0 + v1))];
