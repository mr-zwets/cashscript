+  [Op.OP_2OVER, [{ pick: true, d: 3 }, { pick: true, d: 3 }]],
+  [Op.OP_2SWAP, [{ pick: false, d: 3 }, { pick: false, d: 3 }]],
+  [Op.OP_2ROT, [{ pick: false, d: 5 }, { pick: false, d: 5 }]],
