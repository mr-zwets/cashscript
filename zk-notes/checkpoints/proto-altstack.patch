+// Altstack parking (default on under rescheduleStacks): values whose next use is far away are
+// moved to the altstack instead of being buried and later rolled past intermediate values.
+describe('altstack parking', () => {
+  const PARKING = `
+    function f2mul(int a0, int a1, int b0, int b1) returns (int, int) {
+      int t0 = a0 * b0 % 1000003;
+      int t1 = a1 * b1 % 1000003;
+      int c1 = ((a0 + a1) * (b0 + b1) - t0 - t1) % 1000003;
+      return (t0 - t1) % 1000003, c1;
+    }
+    contract Park() {
+      function spend(
+        int a0, int a1, int a2, int a3, int a4, int a5,
+        int b0, int b1, int b2, int b3, int b4, int b5, int expected,
+      ) {
+        (int x0, int x1) = f2mul(a0, a1, b0, b1);
+        (int y0, int y1) = f2mul(a2, a3, b2, b3);
+        (int s0, int s1) = f2mul(a0 + a2, a1 + a3, b0 + b2, b1 + b3);
+        (int z0, int z1) = f2mul(a4, a5, b4, b5);
+        (int w0, int w1) = f2mul(s0 - x0, s1 - x1, z0, z1);
+        (int v0, int v1) = f2mul(w0 - y0, w1 - y1, x0 + y0, x1 + y1);
+        require(v0 * 7 + v1 * 3 + x0 + y1 == expected);
+      }
+    }`;
+
+  const MOD = 1000003n;
+  const f2mul = (a0: bigint, a1: bigint, b0: bigint, b1: bigint): [bigint, bigint] => {
+    const t0 = (a0 * b0) % MOD;
+    const t1 = (a1 * b1) % MOD;
