+// Borrow-by-depth argument passing (experimental, internal option `borrowArgs`).
+//
+// A user function F may BORROW some of its read-only parameters: instead of the caller copying the
+// argument value to the top of the stack before the call, the callee reads it in place with
+// `<depth> OP_PICK`. The convention is static per function: F's owned (non-borrowed) parameters are
+// staged on top as usual, and below them sits a REGION of `regionSize` stack slots that F reads but
+// never modifies or drops; borrowed parameter j lives at region offset `offsets.get(j)` (offset 0 is
+// the slot directly below the owned arguments). Region slots that hold no borrowed parameter are gaps
+// (unrelated caller values the callee ignores).
+//
+// A call site is emitted IN PLACE when, after staging the owned arguments, every borrowed argument
+// is a variable that already sits at its region slot; otherwise the call site falls back to staging
+// a fresh region (copies + gap fillers), invoking, and dropping the region again. The spec is chosen
+// from a probe compile (offsets observed at every call site must agree) and pruned until no call site
+// needs the fallback (see compileImpl).
+//
+// The stack rescheduler treats an OP_INVOKE of a borrowing function as a block boundary (the region
+// layout must be exactly the one codegen produced), and decompiles the callee body over its whole
+// window (owned arguments + region).
+
+export interface BorrowSpecEntry {
+  offsets: Map<number, number>; // parameter index -> region offset
+  regionSize: number;
+  // Runtime-depth variant: the region may sit at a different depth at every call site. The caller
+  // passes the depth of region slot 0 (at callee entry) as an extra top-most argument, and the callee
+  // reads borrowed parameter j with `<base> OP_PICK <c> OP_ADD OP_PICK`.
+  runtime?: boolean;
+}
+
+export const RUNTIME_BASE_NAME = '$borrowBase';
+
+export type BorrowSpec = Map<string, BorrowSpecEntry>;
+
+export interface BorrowProbe {
+  // per callee: for every emitted call site, per parameter the region offset its argument would have
+  // if borrowed (a variable still on the stack after argument staging), or null
+  sites: Map<string, Array<Array<number | null>>>;
+  // per function: indices of parameters that are used and never reassigned in its body
+  eligible: Map<string, Set<number>>;
+  // callees that needed the fallback staging at some call site
+  fallbacks: Set<string>;
+  inPlace: Map<string, number>;
+}
+
+export const newBorrowProbe = (): BorrowProbe => ({
+  sites: new Map(), eligible: new Map(), fallbacks: new Set(), inPlace: new Map(),
+});
+
+export const regionSlotName = (offset: number): string => `$borrow#${offset}`;
+
+// Static variant: borrow parameter j of F when every observed call site passes, for j, a variable
+// that survives the call at the same region offset. Two parameters may not share a slot.
+export function computeBorrowSpec(probe: BorrowProbe, only?: Set<string>): BorrowSpec {
+  const spec: BorrowSpec = new Map();
+  probe.sites.forEach((sites, callee) => {
+    if (only !== undefined && !only.has(callee)) return;
+    const eligible = probe.eligible.get(callee);
+    if (eligible === undefined || sites.length === 0) return;
+    const offsets = new Map<number, number>();
+    const used = new Set<number>();
+    const n = sites[0].length;
+    for (let j = 0; j < n; j += 1) {
+      if (!eligible.has(j)) continue;
+      const first = sites[0][j];
+      if (first === null || first === undefined) continue;
+      if (!sites.every((site) => site[j] === first)) continue;
+      if (used.has(first)) continue;
+      used.add(first);
+      offsets.set(j, first);
+    }
+    if (offsets.size === 0) return;
+    spec.set(callee, { offsets, regionSize: Math.max(...offsets.values()) + 1 });
+  });
+  return spec;
+}
+
+// Runtime-depth variant: only the RELATIVE offsets of the borrowed parameters must agree across call
+// sites (the base is passed at run time). The first eligible parameter that is a surviving variable
+// at every site is the reference; every other such parameter whose offset difference to it is the
+// same at all sites joins the group.
+export function computeRuntimeBorrowSpec(probe: BorrowProbe, names: Set<string>): BorrowSpec {
+  const spec: BorrowSpec = new Map();
+  probe.sites.forEach((sites, callee) => {
+    if (!names.has(callee)) return;
+    const eligible = probe.eligible.get(callee);
+    if (eligible === undefined || sites.length === 0) return;
+    const n = sites[0].length;
+    const always = [...Array(n).keys()].filter((j) => eligible.has(j) && sites.every((site) => site[j] !== null));
+    if (always.length === 0) return;
+    const reference = always[0];
+    const relative = new Map<number, number>();
+    const used = new Set<number>();
+    always.forEach((j) => {
+      const delta = sites[0][j]! - sites[0][reference]!;
+      if (!sites.every((site) => site[j]! - site[reference]! === delta)) return;
+      if (used.has(delta)) return;
+      used.add(delta);
+      relative.set(j, delta);
+    });
+    const min = Math.min(...relative.values());
+    const offsets = new Map([...relative].map(([j, delta]) => [j, delta - min]));
+    spec.set(callee, { offsets, regionSize: Math.max(...offsets.values()) + 1, runtime: true });
+  });
+  return spec;
+}
+
+// Runtime-depth experiment with an explicit parameter group: the relative layout is the most common
+// one among the call sites that pass every group parameter as a variable; other sites fall back.
+export function computeRuntimeGroupSpec(probe: BorrowProbe, groups: Record<string, number[]>): BorrowSpec {
+  const spec: BorrowSpec = new Map();
+  Object.entries(groups).forEach(([callee, group]) => {
+    const sites = probe.sites.get(callee) ?? [];
+    const eligible = probe.eligible.get(callee);
+    const members = group.filter((j) => eligible?.has(j));
+    if (members.length === 0) return;
+    const patterns = new Map<string, number>();
+    sites.forEach((site) => {
+      if (!members.every((j) => site[j] !== null)) return;
+      const key = members.map((j) => site[j]! - site[members[0]]!).join(',');
+      patterns.set(key, (patterns.get(key) ?? 0) + 1);
+    });
+    const best = [...patterns].sort((a, b) => b[1] - a[1])[0];
+    if (best === undefined) return;
+    const deltas = best[0].split(',').map(Number);
+    if (new Set(deltas).size !== deltas.length) return;
+    const min = Math.min(...deltas);
+    const offsets = new Map(members.map((j, k) => [j, deltas[k] - min]));
+    spec.set(callee, { offsets, regionSize: Math.max(...offsets.values()) + 1, runtime: true });
+  });
+  return spec;
+}
