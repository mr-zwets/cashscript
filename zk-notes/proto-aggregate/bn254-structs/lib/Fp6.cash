pragma cashscript ^0.14.0;

// BN254 Fp6 = Fp2[v]/(v^3 - xi), xi = 9 + u (noble basis).
// An Fp6 element is (c0, c1, c2) with each ci an Fp2 pair -> 6 ints carried as
// (c0a,c0b, c1a,c1b, c2a,c2b) meaning c0 + c1*v + c2*v^2. Builds on Fp2.cash.
import "./Fp2.cash";

struct Fp6 { Fp2 c0; Fp2 c1; Fp2 c2; }

function fp6Add(Fp6 a, Fp6 b) returns (Fp6) {
    Fp2 c0 = fp2Add(a.c0, b.c0);
    Fp2 c1 = fp2Add(a.c1, b.c1);
    Fp2 c2 = fp2Add(a.c2, b.c2);
    return Fp6(c0, c1, c2);
}
function fp6Sub(Fp6 a, Fp6 b) returns (Fp6) {
    Fp2 c0 = fp2Sub(a.c0, b.c0);
    Fp2 c1 = fp2Sub(a.c1, b.c1);
    Fp2 c2 = fp2Sub(a.c2, b.c2);
    return Fp6(c0, c1, c2);
}
function fp6Neg(Fp6 a) returns (Fp6) {
    Fp2 c0 = fp2Neg(a.c0);
    Fp2 c1 = fp2Neg(a.c1);
    Fp2 c2 = fp2Neg(a.c2);
    return Fp6(c0, c1, c2);
}
// multiply by v: v*(c0 + c1 v + c2 v^2) = xi*c2 + c0 v + c1 v^2
function fp6MulByV(Fp6 a) returns (Fp6) {
    Fp2 n0 = fp2MulXi(a.c2);
    return Fp6(n0, a.c0, a.c1);
}
// full Fp6 multiply (Karatsuba over Fp2 with v^3 = xi reduction)
function fp6Mul(Fp6 a, Fp6 b) returns (Fp6) {
    Fp2 t0 = fp2Mul(a.c0, b.c0);
    Fp2 t1 = fp2Mul(a.c1, b.c1);
    Fp2 t2 = fp2Mul(a.c2, b.c2);

    // c0 = t0 + xi*((a1+a2)(b1+b2) - t1 - t2)
    Fp2 s1 = fp2Add(a.c1, a.c2);
    Fp2 s2 = fp2Add(b.c1, b.c2);
    Fp2 p1 = fp2Mul(s1, s2);
    Fp2 d1 = fp2Sub(p1, t1);
    Fp2 d2 = fp2Sub(d1, t2);
    Fp2 x1 = fp2MulXi(d2);
    Fp2 c0 = fp2Add(t0, x1);

    // c1 = (a0+a1)(b0+b1) - t0 - t1 + xi*t2
    Fp2 s3 = fp2Add(a.c0, a.c1);
    Fp2 s4 = fp2Add(b.c0, b.c1);
    Fp2 p2 = fp2Mul(s3, s4);
    Fp2 d3 = fp2Sub(p2, t0);
    Fp2 d4 = fp2Sub(d3, t1);
    Fp2 x2 = fp2MulXi(t2);
    Fp2 c1 = fp2Add(d4, x2);

    // c2 = (a0+a2)(b0+b2) - t0 - t2 + t1
    Fp2 s5 = fp2Add(a.c0, a.c2);
    Fp2 s6 = fp2Add(b.c0, b.c2);
    Fp2 p3 = fp2Mul(s5, s6);
    Fp2 d5 = fp2Sub(p3, t0);
    Fp2 d6 = fp2Sub(d5, t2);
    Fp2 c2 = fp2Add(d6, t1);

    return Fp6(c0, c1, c2);
}
function fp6Sqr(Fp6 a) returns (Fp6) {
    Fp6 c = fp6Mul(a, a);
    return c;
}
function fp6Inv(int c0a,int c0b,int c1a,int c1b,int c2a,int c2b) returns (int,int,int,int,int,int) {
    // t0 = c0^2 - xi(c2 c1)
    (int sq0a,int sq0b) = fp2Sqr(c0a, c0b);
    (int m21a,int m21b) = fp2Mul(c2a, c2b, c1a, c1b);
    (int xm21a,int xm21b) = fp2MulXi(m21a, m21b);
    (int t0a,int t0b) = fp2Sub(sq0a, sq0b, xm21a, xm21b);
    // t1 = xi(c2^2) - c0 c1
    (int sq2a,int sq2b) = fp2Sqr(c2a, c2b);
    (int xsq2a,int xsq2b) = fp2MulXi(sq2a, sq2b);
    (int m01a,int m01b) = fp2Mul(c0a, c0b, c1a, c1b);
    (int t1a,int t1b) = fp2Sub(xsq2a, xsq2b, m01a, m01b);
    // t2 = c1^2 - c0 c2
    (int sq1a,int sq1b) = fp2Sqr(c1a, c1b);
    (int m02a,int m02b) = fp2Mul(c0a, c0b, c2a, c2b);
    (int t2a,int t2b) = fp2Sub(sq1a, sq1b, m02a, m02b);
    // norm = xi(c2 t1 + c1 t2) + c0 t0
    (int ct1a,int ct1b) = fp2Mul(c2a, c2b, t1a, t1b);
    (int ct2a,int ct2b) = fp2Mul(c1a, c1b, t2a, t2b);
    (int suma,int sumb) = fp2Add(ct1a, ct1b, ct2a, ct2b);
    (int xa,int xb) = fp2MulXi(suma, sumb);
    (int c0t0a,int c0t0b) = fp2Mul(c0a, c0b, t0a, t0b);
    (int na,int nb) = fp2Add(xa, xb, c0t0a, c0t0b);
    (int fa,int fb) = fp2Inv(na, nb);
    (int r0a,int r0b) = fp2Mul(fa, fb, t0a, t0b);
    (int r1a,int r1b) = fp2Mul(fa, fb, t1a, t1b);
    (int r2a,int r2b) = fp2Mul(fa, fb, t2a, t2b);
    return r0a, r0b, r1a, r1b, r2a, r2b;
}
// Fp6 Frobenius for ODD power: fp2Frob = conjugate. k1/k2 = FP6_C1[k]/FP6_C2[k].
function fp6FrobOdd(
    int x0a,int x0b,int x1a,int x1b,int x2a,int x2b,
    int k1a,int k1b,int k2a,int k2b
) returns (int,int,int,int,int,int) {
    (int d0a,int d0b) = fp2Conj(x0a, x0b);
    (int c1a,int c1b) = fp2Conj(x1a, x1b);
    (int d1a,int d1b) = fp2Mul(c1a, c1b, k1a, k1b);
    (int c2a,int c2b) = fp2Conj(x2a, x2b);
    (int d2a,int d2b) = fp2Mul(c2a, c2b, k2a, k2b);
    return d0a, d0b, d1a, d1b, d2a, d2b;
}
// Fp6 Frobenius for EVEN power: fp2Frob = identity.
function fp6FrobEven(
    int x0a,int x0b,int x1a,int x1b,int x2a,int x2b,
    int k1a,int k1b,int k2a,int k2b
) returns (int,int,int,int,int,int) {
    (int d1a,int d1b) = fp2Mul(x1a, x1b, k1a, k1b);
    (int d2a,int d2b) = fp2Mul(x2a, x2b, k2a, k2b);
    return x0a, x0b, d1a, d1b, d2a, d2b;
}
// multiply an Fp6 by an Fp2 constant (each Fp2 coord * k).
function fp6MulByFp2(
    int x0a,int x0b,int x1a,int x1b,int x2a,int x2b, int ka,int kb
) returns (int,int,int,int,int,int) {
    (int r0a,int r0b) = fp2Mul(x0a, x0b, ka, kb);
    (int r1a,int r1b) = fp2Mul(x1a, x1b, ka, kb);
    (int r2a,int r2b) = fp2Mul(x2a, x2b, ka, kb);
    return r0a, r0b, r1a, r1b, r2a, r2b;
}
// Fp6 * sparse (b0, b1, 0) — used by the Miller-loop sparse multiply mul034.
function fp6Mul01(int c0a,int c0b,int c1a,int c1b,int c2a,int c2b, int b0a,int b0b,int b1a,int b1b) returns (int,int,int,int,int,int) {
    (int t0a,int t0b) = fp2Mul(c0a, c0b, b0a, b0b);
    (int t1a,int t1b) = fp2Mul(c1a, c1b, b1a, b1b);
    // r0 = xi*((c1+c2)*b1 - t1) + t0
    (int s12a,int s12b) = fp2Add(c1a, c1b, c2a, c2b);
    (int m12a,int m12b) = fp2Mul(s12a, s12b, b1a, b1b);
    (int u0a,int u0b) = fp2Sub(m12a, m12b, t1a, t1b);
    (int xu0a,int xu0b) = fp2MulXi(u0a, u0b);
    (int r0a,int r0b) = fp2Add(xu0a, xu0b, t0a, t0b);
    // r1 = (b0+b1)*(c0+c1) - t0 - t1
    (int sba,int sbb) = fp2Add(b0a, b0b, b1a, b1b);
    (int sca,int scb) = fp2Add(c0a, c0b, c1a, c1b);
    (int m1a,int m1b) = fp2Mul(sba, sbb, sca, scb);
    (int u1a,int u1b) = fp2Sub(m1a, m1b, t0a, t0b);
    (int r1a,int r1b) = fp2Sub(u1a, u1b, t1a, t1b);
    // r2 = (c0+c2)*b0 - t0 + t1
    (int s02a,int s02b) = fp2Add(c0a, c0b, c2a, c2b);
    (int m2a,int m2b) = fp2Mul(s02a, s02b, b0a, b0b);
    (int u2a,int u2b) = fp2Sub(m2a, m2b, t0a, t0b);
    (int r2a,int r2b) = fp2Add(u2a, u2b, t1a, t1b);
    return r0a, r0b, r1a, r1b, r2a, r2b;
}
